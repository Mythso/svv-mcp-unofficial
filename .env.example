# Kopier denne filen til .env for lokal utvikling (og legg .env i .gitignore).
# I Railway settes disse under Project > Service > Variables i stedet.

# --- Delt-konto-modus (enklest, ingen innlogging for brukerne) ---
# Brukes KUN hvis SVV_MCP_PUBLIC_URL under er tom.
DATEX_USERNAME=
DATEX_PASSWORD=

# --- Multi-bruker-modus (hver bruker logger inn med sitt eget DATEX-passord) ---
# Sett denne til den offentlige HTTPS-URL-en Railway gir deg, f.eks.
# https://svv-mcp-unofficial-production.up.railway.app
# for å slå på OAuth-innlogging. La stå tom for delt-konto-modus.
SVV_MCP_PUBLIC_URL=

# Kryptering av lagrede DATEX-credentials. Generer med:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Påkrevd når SVV_MCP_PUBLIC_URL er satt. ALDRI commit denne — kun i Railway Variables.
CREDENTIAL_ENCRYPTION_KEY=

# Sti til SQLite-databasen (krever et Railway-volum montert her i produksjon).
SVV_MCP_DB_PATH=/data/svv_mcp.db

# Settes automatisk av Railway. La stå tom lokalt for å kjøre serveren
# over stdio (f.eks. mot Claude Desktop).
PORT=
