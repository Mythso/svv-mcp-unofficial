# Kopier denne filen til .env for lokal utvikling (og legg .env i .gitignore).
# I Railway settes disse under Project > Service > Variables i stedet.

# Påkrevd for alle DATEX-endepunkter. Registrer deg her:
# https://www.vegvesen.no/en/fag/technology/open-data/a-selection-of-open-data/what-is-datex/get-access/
DATEX_USERNAME=
DATEX_PASSWORD=

# Settes automatisk av Railway. La stå tom lokalt for å kjøre serveren
# over stdio (f.eks. mot Claude Desktop).
PORT=
